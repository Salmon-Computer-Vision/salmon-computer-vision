{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "values": "<DVC_METRIC_DATA>"
  },
  "title": {
    "text": "<DVC_METRIC_TITLE>",
    "anchor": "middle"
  },
  "transform": [
    {
      "filter": "toNumber(datum.gt_count) > 0 || toNumber(datum.pred_count) > 0"
    }
  ],
  "facet": {
    "row": {
      "field": "rev",
      "type": "nominal",
      "title": null,
      "header": {
        "labelFontSize": 12,
        "labelFontWeight": "bold"
      }
    }
  },
  "spec": {
    "width": 520,
    "height": {
      "step": 19
    },
    "layer": [
      {
        "mark": {
          "type": "bar"
        },
        "encoding": {
          "x": {
            "field": "<DVC_METRIC_X>",
            "type": "quantitative",
            "title": "<DVC_METRIC_X_LABEL>",
            "scale": {
              "zero": true
            }
          },
          "y": {
            "field": "<DVC_METRIC_Y>",
            "type": "nominal",
            "sort": "-x",
            "title": null
          },
          "color": {
            "value": "#8F6599"
          },
          "tooltip": [
            {
              "field": "class_name",
              "type": "nominal"
            },
            {
              "field": "MAE_per_video",
              "type": "quantitative",
              "format": ".3f"
            },
            {
              "field": "gt_count",
              "type": "quantitative"
            },
            {
              "field": "pred_count",
              "type": "quantitative"
            },
            {
              "field": "num_videos",
              "type": "quantitative"
            },
            {
              "field": "nMAE",
              "type": "quantitative",
              "format": ".3f"
            }
          ]
        }
      },
      {
        "mark": {
          "type": "text",
          "align": "left",
          "baseline": "middle",
          "dx": 5,
          "fontSize": 10
        },
        "encoding": {
          "x": {
            "field": "<DVC_METRIC_X>",
            "type": "quantitative"
          },
          "y": {
            "field": "<DVC_METRIC_Y>",
            "type": "nominal",
            "sort": "-x"
          },
          "text": {
            "field": "<DVC_METRIC_X>",
            "type": "quantitative",
            "format": ".2f"
          }
        }
      }
    ]
  },
  "resolve": {
    "scale": {
      "y": "independent"
    }
  }
}
