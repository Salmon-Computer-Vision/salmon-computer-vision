{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "values": "<DVC_METRIC_DATA>"
  },
  "title": {
    "text": "<DVC_METRIC_TITLE>",
    "anchor": "middle"
  },
  "transform": [
    {
      "filter": "datum.status == \"scored\" && toNumber(datum.gt_detections) > 0"
    }
  ],
  "facet": {
    "row": {
      "field": "rev",
      "type": "nominal",
      "title": null,
      "header": {
        "labelFontSize": 12,
        "labelFontWeight": "bold"
      }
    }
  },
  "spec": {
    "width": 520,
    "height": {
      "step": 19
    },
    "layer": [
      {
        "mark": {
          "type": "bar"
        },
        "encoding": {
          "x": {
            "field": "<DVC_METRIC_X>",
            "type": "quantitative",
            "title": "<DVC_METRIC_X_LABEL>",
            "scale": {
              "domain": [
                0,
                1.05
              ]
            }
          },
          "y": {
            "field": "<DVC_METRIC_Y>",
            "type": "nominal",
            "sort": "-x",
            "title": null
          },
          "color": {
            "value": "#4A89B8"
          },
          "tooltip": [
            {
              "field": "class_name",
              "type": "nominal"
            },
            {
              "field": "<DVC_METRIC_X>",
              "type": "quantitative",
              "format": ".3f"
            },
            {
              "field": "gt_detections",
              "type": "quantitative"
            },
            {
              "field": "pred_detections",
              "type": "quantitative"
            },
            {
              "field": "FP",
              "type": "quantitative"
            },
            {
              "field": "FN",
              "type": "quantitative"
            }
          ]
        }
      },
      {
        "mark": {
          "type": "text",
          "align": "left",
          "baseline": "middle",
          "dx": 5,
          "fontSize": 10
        },
        "encoding": {
          "x": {
            "field": "<DVC_METRIC_X>",
            "type": "quantitative"
          },
          "y": {
            "field": "<DVC_METRIC_Y>",
            "type": "nominal",
            "sort": "-x"
          },
          "text": {
            "field": "<DVC_METRIC_X>",
            "type": "quantitative",
            "format": ".3f"
          }
        }
      }
    ]
  },
  "resolve": {
    "scale": {
      "y": "independent"
    }
  }
}
