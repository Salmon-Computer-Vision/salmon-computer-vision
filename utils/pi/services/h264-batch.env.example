# All three paths refer to the Raspberry Pi / Docker daemon host.
SALMONMD_IMAGE=your-registry/salmonmd:your-pi-tag
SALMON_REPO=/home/sami/salmon-computer-vision
H264_INPUT_ROOT=/media/usb
H264_OUTPUT_ROOT=/media/usb/motion-results
ARCHIVE_DEVICE_ID=ORG-site-pi-0
# REQUIRED: replace with the actual original camera recording FPS.
# This is NOT a target processing speed. Do not assume a rate from the folder names.
SOURCE_FPS=
