# Paths refer to the Raspberry Pi / Docker daemon host.
SALMONMD_IMAGE=kamicreed/salmonmd:dev-bookworm
SALMON_REPO=/home/netlabmedia/salmon-computer-vision
H264_INPUT_ROOT=/media/remote

# Ensure the drive and SSHFS input are mounted before starting.
# Compose creates the device output directory automatically:
# /media/hdd/UCHU/henderson/pi-0
DRIVE=/media/hdd
ORGID=UCHU
SITE_NAME=henderson
DEVICE_ID=pi-0

# Original recording FPS, not the desired processing speed.
SOURCE_FPS=30

# Dimensions AFTER rotation: 704x480 input becomes 480x704.
FRAME_WIDTH=480
FRAME_HEIGHT=704

# Batch flags; --limit 1 selects one input for an initial check.
# Remove --limit 1 to process all inputs, keeping rotation if needed.
FLAGS=--rotate-90 cw --limit 1

# Without rotation, use FRAME_WIDTH=704, FRAME_HEIGHT=480,
# and FLAGS=--limit 1 (or FLAGS= for the whole archive).
# Optional: --algo CNT
# Do not use the live detector's --cpu_h264 or --url flags here.
# The Compose command already selects --encoder cpu-h264.
